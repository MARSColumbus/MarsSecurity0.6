<plugin name='marsSecurity' version='8.0' grailsVersion='2.2 &gt; *'>
  <type>marssecurity.MarsSecurityGrailsPlugin</type>
  <grailsVersion>2.2 &gt; *</grailsVersion>
  <loadAfter>[springSecurityCore]</loadAfter>
  <authorEmail>daniel.bower@infinum.com</authorEmail>
  <pluginExcludes>[grails-app/views/error.gsp]</pluginExcludes>
  <author>Daniel Bower</author>
  <documentation>http://grails.org/plugin/mars-security</documentation>
  <name>mars-security</name>
  <description>Security Implementation for Mars Grails Apps
</description>
  <title>Mars Security Plugin</title>
  <version />
  <resources>
    <resource>com.mars.security.LoginController</resource>
    <resource>marssecurity.UrlMappings</resource>
    <resource>marssecurity.Application</resource>
    <resource>marssecurity.BootStrap</resource>
  </resources>
</plugin>